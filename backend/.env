# Локальный override для разработки на этой машине.
# Этот файл в .gitignore — у каждого свой. На прод используется .env.example (Postgres).
#
# Почему здесь SQLite, а не Postgres:
#   - Python 3.14 + psycopg2-binary на Windows с русской локалью падает с
#     UnicodeDecodeError ещё до коннекта.
#   - SQLite не требует поднимать сервер — стартует мгновенно.
# Когда поставишь Postgres и/или psycopg v3 — просто закомментируй строку ниже
# и раскомментируй Postgres-строку.

DATABASE_URL=sqlite:///./worktime.db
# DATABASE_URL=postgresql+psycopg2://worktime:worktime@localhost:5432/worktime

# Ключ OpenAI для /ai/* эндпоинтов. Без него AI-роуты вернут 502.
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
