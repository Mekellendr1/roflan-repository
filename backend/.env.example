# ============================================================
# WorkTime Sync — шаблон переменных окружения.
# Скопируй в .env и подставь значения. Сам .env в .gitignore.
# ============================================================

# --- База данных ---
DATABASE_URL=postgresql+psycopg2://worktime:worktime@localhost:5432/worktime
# Альтернатива без сервера:
# DATABASE_URL=sqlite:///./worktime.db

# --- AI-ассистент ---
# Любой провайдер с OpenAI-совместимым API. Раскомментируй нужный блок.

# OpenAI (требует биллинг)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (бесплатный тир, быстро) — console.groq.com
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile

# Google Gemini (бесплатный тир) — aistudio.google.com
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=AIza...
# OPENAI_MODEL=gemini-2.0-flash

# OpenRouter (бесплатные модели с суффиксом :free) — openrouter.ai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama локально — нужен запущенный `ollama serve`
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2
